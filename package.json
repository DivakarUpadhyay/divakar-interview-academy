{
  "name": "divakar-interview-academy",
  "version": "1.0.0",
  "private": true,
  "description": "DevLadder - step-by-step tutorials: .NET, SQL Server, BI, DevOps, Azure and frontend courses, interview Q&A and cheat sheets",
  "scripts": {
    "db": "node scripts/build-db.mjs",
    "dev": "node scripts/build-db.mjs && next dev",
    "build": "node scripts/build-db.mjs && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/content.test.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "highlight.js": "11.12.0",
    "marked": "18.1.1",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  },
  "engines": {
    "node": "22.x"
  }
}
