{
  "name": "divakar-interview-academy",
  "version": "1.0.0",
  "private": true,
  "description": "DevLadder - step-by-step tutorials: .NET, SQL Server, BI, DevOps, Azure and frontend courses, interview Q&A and cheat sheets",
  "scripts": {
    "build": "node scripts/build-db.mjs && next build",
    "db": "node scripts/build-db.mjs",
    "dev": "node scripts/build-db.mjs && next dev",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/content.test.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@vercel/analytics": "2.0.1",
    "better-sqlite3": "13.0.3",
    "highlight.js": "11.12.0",
    "marked": "18.1.1",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": "22.x"
  }
}
